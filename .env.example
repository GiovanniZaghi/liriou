# Banco de dados (PostgreSQL) — usadas pelo docker-compose
POSTGRES_USER=liriou
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=liriou_lp
POSTGRES_PORT=5432

# Conexão usada pela aplicação e pelo drizzle-kit (acrescente ?sslmode=require se o provedor exigir)
DATABASE_URL=postgres://liriou:troque-esta-senha@localhost:5432/liriou_lp

# Dashboard (/dashboard)
ADMIN_PASSWORD=troque-esta-senha
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
