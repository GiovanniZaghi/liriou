# ─── API (liriou-nest) ────────────────────────────────────────────────────────
# Usada pelo navegador (sacola, lista VIP) e, se API_URL não existir, pelo servidor
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# Opcional: URL interna da API para chamadas do servidor Next (catálogo, dashboard)
API_URL=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco de dados e login do dashboard agora ficam na API (veja liriou-nest/.env.example)
